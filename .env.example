# Canopy Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_ENV=development          # development | staging | production
DEBUG=true                   # Enable debug mode
API_HOST=0.0.0.0
API_PORT=8000

# CORS - comma-separated list of allowed origins (use "*" for local dev)
# In production set to your GitHub Pages URL, e.g.:
# CORS_ORIGINS=https://yourusername.github.io
CORS_ORIGINS=*

# Database
# Local development uses SQLite by default (no config needed)
# For PostgreSQL, uncomment and configure:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/esg_copilot
# DATABASE_SYNC_URL=postgresql+psycopg2://user:password@localhost:5432/esg_copilot

# LLM Provider (anthropic or openai)
LLM_PROVIDER=anthropic

# API Keys - Get these from:
# Anthropic: https://console.anthropic.com/
# OpenAI: https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# LLM Model Configuration
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o

# Logging
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json              # json | console

# Data Pipeline (Prefect)
# NOAA API: https://www.ncdc.noaa.gov/cdo-web/webservices/v2
NOAA_API_TOKEN=your-noaa-token-here

# EPA API: https://www.epa.gov/enviro/web-services
# No API key required for most EPA endpoints

# Climate data refresh schedule (cron format)
DATA_REFRESH_SCHEDULE="0 6 * * *"  # Daily at 6 AM
